{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidharthify",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidharthify-views",
      "database_id": "188ef91a-4bbf-43b6-8a0d-0db0be37d6fb",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
